// Arithmetic in the BN254 scalar field, on plain `u256` values.
// Inputs are expected to be reduced (< P).
use std::evm::crypto::{addmod, modexp, mulmod}
use super::errors::{InvertOfZero, ModExpFailed}

/// BN254 scalar field modulus (the field the circuit is defined over).
pub const P: u256 = 21888242871839275222246405745257275088548364400416034343698204186575808495617

/// BN254 base field modulus (the field of curve point coordinates).
pub const Q: u256 = 21888242871839275222246405745257275088696311157297823662689037894645226208583

pub fn add(_ a: u256, _ b: u256) -> u256 {
    addmod(a, b, P)
}

/// Panics if `b > P`; Solidity wraps instead, so only reduced values may reach it.
pub fn sub(_ a: u256, _ b: u256) -> u256 {
    addmod(a, P - b, P)
}

pub fn mul(_ a: u256, _ b: u256) -> u256 {
    mulmod(a, b, P)
}

/// Returns 0 for 0, where Solidity's `FrLib.neg` returns the unreduced `P`.
pub fn neg(_ a: u256) -> u256 {
    sub(0, a)
}

/// Multiplicative inverse by Fermat's little theorem. Reverts on 0: the
/// precompile would silently return 0, which is not an inverse.
pub fn inv(_ a: u256) -> u256 {
    if a == 0 {
        revert_error(InvertOfZero {})
    }
    match modexp(base: a, exp: P - 2, modulus: P) {
        Result::Ok(value) => value,
        Result::Err(_) => revert_error(ModExpFailed {}),
    }
}

#[test]
fn test_add_wraps_at_modulus() {
    assert!(add(P - 1, 1) == 0)
    assert!(add(P - 1, 2) == 1)
}

#[test]
fn test_sub_wraps_below_zero() {
    assert!(sub(0, 1) == P - 1)
    assert!(sub(5, 3) == 2)
    assert!(sub(3, 3) == 0)
}

#[test]
fn test_mul_reduces() {
    assert!(mul(P - 1, P - 1) == 1)
    assert!(mul(P - 1, 2) == P - 2)
}

#[test]
fn test_neg() {
    assert!(neg(0) == 0)
    assert!(neg(1) == P - 1)
    assert!(add(neg(7), 7) == 0)
}

#[test]
fn test_inv_times_value_is_one() {
    assert!(mul(inv(2), 2) == 1)
    assert!(mul(inv(P - 1), P - 1) == 1)
    assert!(inv(1) == 1)
}

// selector of InvertOfZero()
#[test(should_revert, selector = 0xb2c952e2)]
fn test_inv_of_zero_reverts() {
    inv(0)
}
