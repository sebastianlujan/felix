const LIBRA_CHALLENGE: u256 = 0x1aa927d1b2c064281557b6fb8c2617cf6c2978c0e184c7d48dc5fee663c3ba68
const U: [u256; 12] = [
    0x004d2914755ff9d8f4814794739ce7bc8790a2713235fb1e0fadc8ba49a42509,
    0x0bbbabb4f9b099f517304b8eee72304179d78d6a5d35591cd82f6526b40ab014,
    0x1d0f31b1dccf18c1c62b1497d3701f20e8d6d5a4de902052fa9c5e3f2a132eaa,
    0x04dad0fb1617e919c0c3516797da7ceb5aaae50f3040f867e5a5204cf7923717,
    0x0d7525b5bf4440f12475b6721213e271feaa6b3ea8b04648726c23e7f1908c1a,
