use std::abi::{Bytes32, bytes_from_words, dyn_array_from}
use super::garaga_hello_proof::{PROOF, PUBLIC_INPUTS}
use super::types::VerificationKey

pub const VK: VerificationKey = VerificationKey {
    log_n: LOG_N,
    num_public_inputs: NUM_PUBLIC_INPUTS,
    vk_hash: VK_HASH,
    points: VK_POINTS,
}

fn proof() -> Bytes {
    bytes_from_words(PROOF)
}

fn public_inputs() -> Vec<Bytes32> {
    dyn_array_from([Bytes32 { val: PUBLIC_INPUTS[0] }])
}

// THE CHALLENGES GARAGA EXPECTS for this proof: `get_expected_transcript` in
// `src/src/apps/noir/test_fixtures.cairo` of the same commit (MIT). Garaga's own test compares
// them with the transcript of its Cairo verifier, and the same file holds this proof and
// this key. Each is one Cairo `u256` literal holding the whole challenge, the Keccak digest
// reduced modulo `P`: not limbs, and not a 128-bit half. Transcribed with the leading zeros
// written out.
const ETA: u256 = 0x1003897fa79b37adf4bf0286ea90ddac0e83ac267d8de4656855c43c525a9ba9
const ROM_LOGUP_GAMMA: u256 = 0x291bdc782e645f0c2bf4192e2c203d02a2ad94ed03b602407790bd7f6c4aee5c
const BETA: u256 = 0x2522f39d99a0520317f0c38bc944c35e28bb28c32f287ffd66e2a859c5fb579b
const GAMMA: u256 = 0x1f3f6a4c4b5546485d8c2a7a1f1ea21c8b329db47b54fcd605d04a83d9e970f8
const ALPHA: u256 = 0x2edb283de8851b5cca44c2614143b8527e6558d6eab7fa5bbf4b587a4dac10b4
