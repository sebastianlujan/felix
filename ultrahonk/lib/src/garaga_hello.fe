    0x015ef203d6b84a1b005e4e0e5170a5f591025bb3d4d8bd0cce0d3bed32f1e09d,
]
const RHO: u256 = 0x0d5de6cc9d4acd457f0e8019c0fd8fa251e4273723ec23a933bc83fe8f82a9f9
const GEMINI_R: u256 = 0x1d234ecd87a38e9a812d58b57b777cf1e504fd7d698b5b1aaac7bbf8244aa94b
const SHPLONK_NU: u256 = 0x0207ef97e69bb068ee8af8672d81cddeae9dfc7b25edc9638abb094fb5ec2d17
const SHPLONK_Z: u256 = 0x165a2f60e40fc61ab672c3de0b377742dbd3243f533ae3ae6f037bb093c10c82

// Tests. The first compares this port's transcript with Garaga's; the others verify the
// proof with every step of the verifier (`verifier::verify`).
use std::evm::Evm
use super::transcript::generate
use super::types::MAX_LOG_N
use super::verifier::{accepted_bit_flips, accepts, deploy_keyed_verifier, verify}

#[test]
fn test_garaga_hello_challenges_equal_garagas() {
    let t = generate(vk: VK, proof(), public_inputs())
    assert!(t.eta == ETA)
    assert!(t.rom_logup_gamma == ROM_LOGUP_GAMMA)
    assert!(t.beta == BETA)
    assert!(t.gamma == GAMMA)
    assert!(t.alpha == ALPHA)
    assert!(t.gate_challenge == GATE_CHALLENGE)
    assert!(t.libra_challenge == LIBRA_CHALLENGE)
    assert!(U.len() == LOG_N)
    for round in 0 .. MAX_LOG_N {
        assert!(t.u[round] == if round < LOG_N { U[round] } else { 0 })
    }
    assert!(t.rho == RHO)
    assert!(t.gemini_r == GEMINI_R)
    assert!(t.shplonk_nu == SHPLONK_NU)
    assert!(t.shplonk_z == SHPLONK_Z)
}

#[test]
fn test_garaga_hello_is_accepted() {
    assert!(verify(vk: VK, proof(), public_inputs()))
}

// The low bit of each of the 226 proof words, one word at a time.
#[test]
fn test_garaga_hello_with_one_bit_changed_is_never_accepted()
uses (evm: mut Evm)
{
    assert!(PROOF.len() == 226)
    assert!(
        accepted_bit_flips(vk: VK, words: PROOF, public_inputs: public_inputs()) == 0,
    )
}

#[test]
fn test_garaga_hello_with_a_changed_public_input_is_not_accepted()
uses (evm: mut Evm)
{
    let verifier = deploy_keyed_verifier()
    assert!(
        accepts(
            verifier,
            vk: VK,
            proof: proof(),
            public_inputs: public_inputs(),
        ),
    )
    let changed = dyn_array_from([Bytes32 { val: PUBLIC_INPUTS[0] + 1 }])
    assert!(
        !accepts(verifier, vk: VK, proof: proof(), public_inputs: changed),
    )
}
