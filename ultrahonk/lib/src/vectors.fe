use std::abi::{Bytes32, bytes_from_words, dyn_array_from}
// The verification key lives in `vk.fe`, which `HonkVerifier` imports; re-exported here so the
// tests keep finding it next to the proof.
pub use super::vk::{LOG_N, N, NUM_PUBLIC_INPUTS, VK, VK_HASH, VK_POINTS}

/// The pinned proof as the caller sends it.
pub fn proof() -> Bytes {
    bytes_from_words(PROOF)
}

/// The pinned proof with word `word` replaced by `value`.
pub fn proof_with(word: usize, value: u256) -> Bytes {
    var words = PROOF
    words[word] = value
    bytes_from_words(words)
}

pub fn public_inputs() -> Vec<Bytes32> {
    dyn_array_from(
        [Bytes32 { val: PUBLIC_INPUTS[0] }, Bytes32 { val: PUBLIC_INPUTS[1] }],
    )
}

// VALUES CAPTURED FROM THE REFERENCE VERIFIER, for the proof and public inputs above.
//
// Provenance: the Solidity verifier that `bb` 6.0.0 generates for `vectors/vk` with
// `write_solidity_verifier -t evm` (sha256 5609d13d...8bfe), compiled with solc 0.8.34
// (optimizer_runs = 1, evm_version = osaka) and run under forge 1.5.1 on 2026-11-22. That
// verifier is not part of this repository; `scripts/vectors.sh` regenerates it under `.oracle/`.
//
// How: a local Foundry test deployed a contract inheriting from that verifier and logged, for
// `vectors/proof` and `vectors/public_inputs`:
//   - the fields of the struct its `generateTranscript` returns (the challenges);
//   - the result of its `computePublicInputDelta`;
//   - the values of `roundTargetSum` and `powPartialEvaluation` in the round loop of its
//     `verifySumcheck`, repeated in the test contract around the verifier's own
//     `computeNextTargetSum`.
// The same test asserts that `vectors/vk` holds the points of that verifier's key in the order
// of `VK_POINTS`, and that it accepts the proof.

// Challenges, in the order the transcript produces them.
pub const ETA: u256 = 0x01d584e55acbf5896679c291e49bc5c578764639a9905580fbc4443a29fca033
pub const ROM_LOGUP_GAMMA: u256 = 0x1220a5dcdf55daaad2c525eae7378216d8ac723417a4d8bfe0df5db27d4d78e3
pub const BETA: u256 = 0x168beb184ad2da7bf60fe59a319aeb25544ab5d9d1c1d57d68ef984b79f24c61
pub const GAMMA: u256 = 0x18a803b54b32fd70fe0720adba4a95f5c6bbf5607efb3b0f0a71b3c7bf8f20b9

/// `alphas[0]`; the reference stores its powers `alphas[i] = ALPHA^(i + 1)`.
pub const ALPHA: u256 = 0x14856aebeb98826adcde09056e202dfc8b74ae16ee5db13b5077a00225941cd2

/// `gateChallenges[0]`; `gateChallenges[i]` is the square of `gateChallenges[i - 1]`.
pub const GATE_CHALLENGE: u256 = 0x11bed69fd7d7a2ea8105abae63e622a6f6071782801603f9d142fe240a467fe2
pub const LIBRA_CHALLENGE: u256 = 0x04a76d0fcfde883a4d6caf814e756a9d451507d966de52d9ac32639dc2187b86

/// Sumcheck challenges `u[0..LOG_N)`. The reference leaves `u[LOG_N..25)` at zero.
pub const U: [u256; 5] = [
    0x081fb3d7e7684fd60a538f3498d30785f0c40c06bca9ad04934d5b394638792d,
    0x260128cfeb26147df36130cc268c6bb4599640ec7520298b9446edde501cae39,
    0x0d9de9f43e110200989c7b79ce1ac961ebdd87d58aaa1b21fda564265e233d4c,
    0x2d3599dbae5fa4fb5a02465f0b9d482d5df40954dd270a578efdb25a55217a38,
    0x0c9dac3bb291a2640785f59d130685084aef9c72e041803bf51c6cc7bd7f8ad1,
]
pub const RHO: u256 = 0x2080869f066ff8532657750b16974518cef01aaea279ef0b038fca2510e9c2f1
pub const GEMINI_R: u256 = 0x00d1e4dc846c1f5b20f0d5306aa79fe3feaf2cbda7ae775cee26c21643e5f956
pub const SHPLONK_NU: u256 = 0x09a2add74c0cada33a7198bd75ca849e8d075eca7b6ea3d77f5423fc462c0ec8
pub const SHPLONK_Z: u256 = 0x1d32296b333e2ae4abc031764fecd1ae3d51bd754d5c9830a2c69416e8af4328

pub const PUBLIC_INPUT_DELTA: u256 = 0x03c84ee7d42b94625f024c3f8048be12d7c97943cc881132b5849cfe819efa0e

/// Sumcheck target before round `i` for `i < LOG_N`, and after the last round at `LOG_N`.
/// The first is `LIBRA_CHALLENGE * libraSum` (proof word 28).
pub const ROUND_TARGETS: [u256; 6] = [
    0x2a3f7527ef4fb21bce95cbac7955e15fb524dcb5629830d46a5fbafcd9c06720,
    0x0e7bc198765274dddf11bcf52ea618071b3ec91c115fc752d293315bddcd5850,
    0x1e6bac868d2ad44ec1e74e8e219fc558cb591e6b9825dd708409b4be3a177079,
    0x04a97051d70f4100403cf886756c64683e1ac35d31166db56f062e81da9c6a00,
    0x25b15ae09e192601575187f09b3ef4b980d2bc171d315e6d0dcb3bd2f49f5681,
    0x1bee893a8684e5d174c35123ac0b8ec50592a29e332cd757f5b120d353201a00,
]

/// `powPartialEvaluation` after the last round.
pub const PARTIAL_POW: u256 = 0x08e53a6e84de551dd2e40d05af3b6068f946f626f690445c57692208014d5b45

#[test]
fn test_vector_sizes_follow_the_circuit() {
    assert!(N == 1 << LOG_N)
    assert!(PROOF.len() == 82 + 12 * LOG_N)
    assert!(PUBLIC_INPUTS.len() == NUM_PUBLIC_INPUTS - 8)
    assert!(U.len() == LOG_N)
    assert!(ROUND_TARGETS.len() == LOG_N + 1)
}
