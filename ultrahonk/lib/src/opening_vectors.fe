// What `verifyShplemini` did with other limbs, under the same conditions. `A` and `B` are the
// points of `OTHER_CARRIED`.
//
//   A, (0, 0)                      -> reverted with PointAtInfinity (0x4ddaa5e5)
//   (0, 0), B                      -> reverted with PointAtInfinity
//   limb 0 = 1, the others zero    -> reverted with PointAtInfinity
//   one coordinate = Q (each of 4) -> reverted with ValueGeGroupOrder (0x607be13e)
//   P0.x = Q and P1 = (0, 0)       -> reverted with ValueGeGroupOrder: the range comes first
//   P0.x = 2^256 - 1               -> reverted with ValueGeGroupOrder (limbs 2^136 - 1, 2^120 - 1)
//   P0.x = Q - 1                   -> reverted with no data: in range, off the curve
//   P0 = (1, 3), or P1 = (1, 3)    -> reverted with no data: `ecAdd` fails in `mulWithSeperator`

// What `verifyShplemini` alone did with the lowest bit of one proof word flipped and the
// challenges generated again from the tampered proof, called with 20,000,000 gas. The whole
// verifier (`expected::BIT_FLIPS`) turns a returned `false` into `ShpleminiFailed`.
//
//   74, 121, 134, 137 -> reverted with ConsistencyCheckFailed (0xa2a2ac83)
//   129               -> returned false: the pairing does not hold
//   140               -> reverted with ShpleminiFailed (0xa5d82e8a) in `batchMul`: the KZG
//                        quotient is off the curve and the precompile call fails
//   138               -> reverted with no data: `shplonkQ` is off the curve, the failed
//                        precompile call takes the gas and `batchMul` runs out of it

use super::fr::Q
use super::vectors::{GEMINI_R, LOG_N, PROOF, SHPLONK_Z}

// The captured values belong to the proof and the challenges of `vectors.fe`.
#[test]
fn test_opening_vectors_follow_the_circuit() {
    assert!(SQUARES.len() == LOG_N)
    assert!(FOLD_POS.len() == LOG_N)
    assert!(FOLD_POS_INV.len() == LOG_N - 1)
    assert!(FOLD_NEG_INV.len() == LOG_N - 1)
    assert!(SCALARS.len() == 42 + LOG_N)
    assert!(COMMITMENTS.len() == 2 * SCALARS.len())
    assert!(SQUARES[0] == GEMINI_R)
    assert!(SCALARS[0] == 1)
    assert!(SCALARS[40 + LOG_N] == CONSTANT_TERM)
    assert!(SCALARS[41 + LOG_N] == SHPLONK_Z)
    assert!(LIBRA_DENOMINATORS[0] == POS_INV)
    assert!(DIFF == 0)
}

#[test]
fn test_captured_p1_is_the_negated_kzg_quotient() {
    assert!(P1_X == PROOF[140])
    assert!(P1_Y == Q - PROOF[141])
}

#[test]
fn test_own_limbs_carry_the_captured_pairing_points() {
    assert!(OWN_CARRIED[0] == P0_X)
    assert!(OWN_CARRIED[1] == P0_Y)
    assert!(OWN_CARRIED[2] == P1_X)
    assert!(OWN_CARRIED[3] == P1_Y)
}
