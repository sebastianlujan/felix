/// `generateRecursionSeparator(OTHER_LIMBS, P0, P1)`.
pub const OTHER_SEPARATOR: u256 = 0x147c2add71f5a43481e358c37ac16f2b1388964d421bdd98cb4157b852c773bd

/// `OTHER_SEPARATOR * P0 + carried P0` and the same for `P1` (`mulWithSeperator`), as
