// END OF GENERATED PART
use std::abi::{Bytes32, bytes_from_words, dyn_array_from}
use super::garaga_recursive_proof::{PROOF, PUBLIC_INPUTS}
use super::types::VerificationKey

pub const VK: VerificationKey = VerificationKey {
    log_n: LOG_N,
    num_public_inputs: NUM_PUBLIC_INPUTS,
    vk_hash: VK_HASH,
    points: VK_POINTS,
}

fn proof() -> Bytes {
    bytes_from_words(PROOF)
}

fn public_inputs() -> Vec<Bytes32> {
    dyn_array_from([Bytes32 { val: PUBLIC_INPUTS[0] }])
}

// Tests: every step of the verifier (`verifier::verify`), at `LOG_N = 20`, on a proof whose
// circuit verifies another proof. Garaga pins no challenges for this proof.
use std::evm::Evm
use super::opening::{negate, pairing, pairing_points}
use super::proof::evaluations
use super::transcript::generate
use super::types::PAIRING_POINTS_SIZE
use super::verifier::{accepted_bit_flips, verify}
use super::wire::{
    Q_ELLIPTIC,
    Q_LOOKUP,
    Q_MEMORY,
    Q_NNF,
    Q_POSEIDON2_EXTERNAL,
    Q_POSEIDON2_INTERNAL,
    Q_RANGE,
}
use super::{garaga_hello_proof, garaga_mutator_set_proof, vectors}

#[test]
fn test_garaga_recursive_is_accepted() {
    assert!(verify(vk: VK, proof(), public_inputs()))
}

// The eight limbs at the start of this proof are not zero: it carries the pairing points of
// the proof its circuit verified, and the opening must aggregate them into its own. No other
// proof of this repository takes that branch. Without the aggregation the second point of
// the pairing is the negated KZG quotient, the last point of the proof; here it is not.
#[test]
fn test_garaga_recursive_goes_through_the_aggregation() {
    for limb in 0 .. PAIRING_POINTS_SIZE {
        assert!(PROOF[limb] != 0)
    }
    let t = generate(vk: VK, proof(), public_inputs())
    let points = pairing_points(vk: VK, proof(), t)
    let (x, y) = negate(x: PROOF[PROOF.len() - 2], y: PROOF[PROOF.len() - 1])
    assert!(points.p1_x != x || points.p1_y != y)
    assert!(pairing(points))
}

// The low bit of each of the 322 proof words, one word at a time. The first eight are the
// limbs of the carried points.
#[test]
fn test_garaga_recursive_with_one_bit_changed_is_never_accepted()
uses (evm: mut Evm)
{
    assert!(PROOF.len() == 322)
    assert!(
        accepted_bit_flips(vk: VK, words: PROOF, public_inputs: public_inputs()) == 0,
    )
}

/// Whether the selector `entity` evaluates to zero at the sumcheck point of the proof `words`.
fn selector_is_zero<const N: usize>(_ words: [u256; N], _ log_n: usize, _ entity: usize) -> bool {
    words[evaluations(log_n) + 1 + entity] == 0
}

// What the three Garaga proofs add to the pinned one. The range, elliptic, memory, non-native
// field and Poseidon2 relations are scaled by their selector: where it evaluates to zero at
// the sumcheck point they add nothing to the batched value, and an accepted proof says
// nothing about them. In the pinned proof every gate selector but `qArith` is zero there,
// the lookup one too. In these proofs the range, lookup, memory, non-native field and both
// Poseidon2 selectors are not zero, in one proof at least; the elliptic one is zero in all.
#[test]
fn test_garaga_proofs_reach_every_gate_selector_but_the_elliptic_one() {
    let hello = garaga_hello_proof::PROOF
    let mutator_set = garaga_mutator_set_proof::PROOF
    for gate in [Q_RANGE, Q_MEMORY, Q_NNF, Q_POSEIDON2_EXTERNAL, Q_POSEIDON2_INTERNAL] {
        assert!(selector_is_zero(vectors::PROOF, vectors::LOG_N, gate))
        assert!(!selector_is_zero(PROOF, LOG_N, gate))
    }
    assert!(selector_is_zero(vectors::PROOF, vectors::LOG_N, Q_LOOKUP))
    assert!(!selector_is_zero(mutator_set, 17, Q_LOOKUP))
    assert!(!selector_is_zero(mutator_set, 17, Q_MEMORY))
    assert!(!selector_is_zero(hello, 12, Q_RANGE))
    assert!(!selector_is_zero(mutator_set, 17, Q_RANGE))

    assert!(
        selector_is_zero(vectors::PROOF, vectors::LOG_N, Q_ELLIPTIC),
    )
    assert!(selector_is_zero(hello, 12, Q_ELLIPTIC))
    assert!(selector_is_zero(mutator_set, 17, Q_ELLIPTIC))
    assert!(selector_is_zero(PROOF, LOG_N, Q_ELLIPTIC))
}
