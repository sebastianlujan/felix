// Reverts of the reference verifier, recorded so the Fe port can be held to them.
//
// Provenance of every value in this module: the Solidity verifier that Barretenberg
// `bb` 6.0.0 generates for `vectors/vk` with `write_solidity_verifier -t evm` (the ZK
// flavor), compiled with solc 0.8.34 (optimizer_runs = 1, evm_version = osaka) and
// called under forge 1.5.1 with `vectors/proof` (sha256 7ff3d740...ad96553) and
// `vectors/public_inputs`, 20,000,000 gas per call, on 2026-11-22. That verifier is
// not part of this repository; `scripts/vectors.sh` regenerates it under `.oracle/`.
//
// Each case changes one thing in the otherwise valid call, except the proofs built from
// a rule, near the end. A selector is the first four bytes of the revert data the
// reference verifier returned. Words are 32-byte words of the proof, counted from 0.
//
// These values belong to the committed proof. A regenerated proof keeps the lengths,
// the range checks and the public-input cases, but its bit flips have to be captured
// again.
use core::error::ErrorVariant
use std::abi::{Sol, bytes_from_words}
use super::errors::{
    ConsistencyCheckFailed,
    ProofLengthWrongWithLogN,
    PublicInputsLengthWrong,
    ShpleminiFailed,
    SumcheckFailed,
    ValueGeFieldOrder,
    ValueGeGroupOrder,
    ValueGeLimbMax,
}
use super::fr::{P, Q}

/// Length of a proof for this circuit: `(82 + 12 * LOG_N) * 32` with `LOG_N = 5`.
pub const PROOF_LENGTH: usize = 4544

// Selectors returned by the reference verifier. They equal the selectors of the
// errors of the same name in `errors` (checked by a test below).
pub const PROOF_LENGTH_WRONG_WITH_LOG_N: u32 = 0x59895a53
pub const VALUE_GE_LIMB_MAX: u32 = 0xeb73e0bd
pub const VALUE_GE_GROUP_ORDER: u32 = 0x607be13e
pub const VALUE_GE_FIELD_ORDER: u32 = 0x20a33589
pub const PUBLIC_INPUTS_LENGTH_WRONG: u32 = 0xfa066593
pub const SUMCHECK_FAILED: u32 = 0x9fc3a218
pub const CONSISTENCY_CHECK_FAILED: u32 = 0xa2a2ac83
pub const SHPLEMINI_FAILED: u32 = 0xa5d82e8a

// Wrong proof length. The revert data was 100 bytes each time:
// `PROOF_LENGTH_WRONG_WITH_LOG_N`, then the words `WRONG_LENGTH_LOG_N`, the length
// of the proof that was sent, and `PROOF_LENGTH`.
//
//   96 bytes   -> 0x59895a53 | 0x05 | 0x60   | 0x11c0
//   4512 bytes -> 0x59895a53 | 0x05 | 0x11a0 | 0x11c0   (one word short)
//   4576 bytes -> 0x59895a53 | 0x05 | 0x11e0 | 0x11c0   (one word long)
//   0 bytes    -> 0x59895a53 | 0x05 | 0x00   | 0x11c0   (empty proof)
pub const WRONG_LENGTH_LOG_N: u256 = 5
pub const WRONG_LENGTHS: [usize; 4] = [96, 4512, 4576, 0]

/// The lowest bit of proof word `word` flipped.
pub struct BitFlip { pub word: usize, pub selector: u32 }

impl Copy for BitFlip {}

pub const BIT_FLIPS: [BitFlip; 11] = [
    // Gemini masking commitment, x coordinate
    BitFlip { word: 8, selector: SUMCHECK_FAILED },
    // Libra sum
    BitFlip { word: 28, selector: SUMCHECK_FAILED },
    // first value of the first sumcheck univariate
    BitFlip { word: 29, selector: SUMCHECK_FAILED },
    // evaluation of the Gemini masking polynomial (sumcheck evaluation 0)
    BitFlip { word: 74, selector: CONSISTENCY_CHECK_FAILED },
    // evaluation of the first entity the relations read (sumcheck evaluation 1)
    BitFlip { word: 75, selector: SUMCHECK_FAILED },
    // Libra evaluation
    BitFlip { word: 116, selector: SUMCHECK_FAILED },
    // first Gemini fold commitment, x coordinate
    BitFlip { word: 121, selector: CONSISTENCY_CHECK_FAILED },
    // first Gemini evaluation
    BitFlip { word: 129, selector: SHPLEMINI_FAILED },
    // first and last Libra polynomial evaluation
    BitFlip { word: 134, selector: CONSISTENCY_CHECK_FAILED },
    BitFlip { word: 137, selector: CONSISTENCY_CHECK_FAILED },
    // KZG quotient, x coordinate
    BitFlip { word: 140, selector: SHPLEMINI_FAILED },
]

/// Flipping the lowest bit of this word (Shplonk quotient, x coordinate) made the
/// reference verifier revert with no data: the point is off the curve, a failed
/// precompile call consumes all the gas forwarded to it, and the rest of the
/// multi-scalar multiplication ran out of gas. A port only has to revert here.
pub const BIT_FLIP_WITHOUT_REVERT_DATA: usize = 138

/// Proof word `word` replaced by `value`.
pub struct Overwrite { pub word: usize, pub value: u256, pub selector: u32 }

impl Copy for Overwrite {}

pub const OVERWRITES: [Overwrite; 7] = [
    // pairing-point limbs: even words hold 136 bits, odd words 120
    Overwrite { word: 0, value: 1 << 136, selector: VALUE_GE_LIMB_MAX },
    Overwrite { word: 1, value: 1 << 120, selector: VALUE_GE_LIMB_MAX },
    // the largest low limb passes the range check and fails the proof instead
    Overwrite { word: 0, value: (1 << 136) - 1, selector: SUMCHECK_FAILED },
    // coordinates of the first and of the last commitment
    Overwrite { word: 8, value: Q, selector: VALUE_GE_GROUP_ORDER },
    Overwrite { word: 9, value: Q, selector: VALUE_GE_GROUP_ORDER },
    Overwrite { word: 141, value: Q, selector: VALUE_GE_GROUP_ORDER },
    // the first scalar (Libra sum)
    Overwrite { word: 28, value: P, selector: VALUE_GE_FIELD_ORDER },
]

/// Every proof word replaced by `Q`, one word at a time: the range check that rejected it.
/// `Q` is above all three bounds, so the selector tells which kind of value the reference
/// reads at that word. Each entry is the first word after a run and the selector of the run:
/// words 0-7 `VALUE_GE_LIMB_MAX`, 8-27 `VALUE_GE_GROUP_ORDER`, 28-116
/// `VALUE_GE_FIELD_ORDER`, 117-128 `VALUE_GE_GROUP_ORDER`, 129-137 `VALUE_GE_FIELD_ORDER`,
/// 138-141 `VALUE_GE_GROUP_ORDER`. The revert data was the bare selector every time.
pub struct WordRun { pub end: usize, pub selector: u32 }

impl Copy for WordRun {}

pub const Q_OVERWRITE_RUNS: [WordRun; 6] = [
    WordRun { end: 8, selector: VALUE_GE_LIMB_MAX },
    WordRun { end: 28, selector: VALUE_GE_GROUP_ORDER },
    WordRun { end: 117, selector: VALUE_GE_FIELD_ORDER },
    WordRun { end: 129, selector: VALUE_GE_GROUP_ORDER },
    WordRun { end: 138, selector: VALUE_GE_FIELD_ORDER },
    WordRun { end: 142, selector: VALUE_GE_GROUP_ORDER },
]

/// Public input `index` replaced by `value`. The valid inputs are `[9, 0xc0ffe]`.
pub struct PublicInputChange { pub index: usize, pub value: u256, pub selector: u32 }

impl Copy for PublicInputChange {}

pub const PUBLIC_INPUT_CHANGES: [PublicInputChange; 3] = [
    PublicInputChange { index: 0, value: 10, selector: SUMCHECK_FAILED },
    PublicInputChange { index: 1, value: 0xbeef, selector: SUMCHECK_FAILED },
    PublicInputChange { index: 0, value: P, selector: VALUE_GE_FIELD_ORDER },
]

/// Numbers of public inputs, other than the 2 the circuit has, that were sent.
/// Each reverted with `PUBLIC_INPUTS_LENGTH_WRONG`.
pub const WRONG_PUBLIC_INPUT_COUNTS: [usize; 3] = [0, 1, 3]

// Order of the checks, from calls that break two rules at once:
//
//   word 0 = 2^136 and word 141 = Q      -> VALUE_GE_LIMB_MAX
//   word 8 = Q and word 28 = P           -> VALUE_GE_GROUP_ORDER
//   1 public input and word 28 = P       -> VALUE_GE_FIELD_ORDER
//   1 public input, and that input = P   -> PUBLIC_INPUTS_LENGTH_WRONG
//
// So: proof length, then the proof words in order (limbs, then every coordinate and
// scalar), then the number of public inputs, then the range of each public input.

// Sumcheck on its own. A contract inheriting from the reference verifier ran the steps
// of `verify` up to `verifySumcheck` and returned its verdict, for the cases above:
//
//   bit flips in words 8, 28, 29            reverted with SUMCHECK_FAILED (its round loop)
//   bit flips in words 75, 116              returned false (its last comparison)
//   the other seven bit flips               returned true
//   public input 0 = 10, input 1 = 0xbeef   reverted with SUMCHECK_FAILED (its round loop)
//
// So the reference rejects seven of the twelve recorded flips after sumcheck: sumcheck does
// not read evaluation 0 (word 74) or any proof word after the Libra evaluation (word 116).

/// Bit flips for which `verifySumcheck` returned false.
pub const SUMCHECK_RETURNS_FALSE: [usize; 2] = [75, 116]

/// Bit flips for which `verifySumcheck` returned true.
pub const SUMCHECK_RETURNS_TRUE: [usize; 7] = [74, 121, 129, 134, 137, 138, 140]

// Proofs of the right length built from a rule instead of from the valid proof.

/// A proof of `PROOF_LENGTH` zero bytes, sent with the valid public inputs and with two
/// zero public inputs: the selector `verify` reverted with, both times.
///
/// `verifySumcheck` returned true for both. Every round value, every evaluation and both
/// Libra terms are zero, so each of its checks compares 0 with 0: sumcheck alone does not
/// tie a proof to the circuit, the opening proof does.
pub const ZERO_PROOF: u32 = SHPLEMINI_FAILED
pub const ZERO_PROOF_PASSES_SUMCHECK: bool = true

/// Every proof word at the largest value its range check accepts (`largest_values`), and
/// the same proof with the eight limbs at zero: the selector `verify` reverted with, both
/// times. `verifySumcheck` reverted with it in its round loop.
pub const LARGEST_VALUES: u32 = SUMCHECK_FAILED

/// The proof whose every word is the largest value its range check accepts: `2^136 - 1`
/// and `2^120 - 1` for the limbs (zero instead when `limbs` is false), `Q - 1` for
/// coordinates, `P - 1` for scalars. The kind of each word comes from `Q_OVERWRITE_RUNS`.
pub fn largest_values(limbs: bool) -> Bytes {
    var words: [u256; 142] = [0; 142]
    var word: usize = 0
    for run in Q_OVERWRITE_RUNS {
        while word < run.end {
            words[word] = if run.selector == VALUE_GE_GROUP_ORDER {
                Q - 1
            } else if run.selector == VALUE_GE_FIELD_ORDER {
                P - 1
            } else if !limbs {
                0
            } else if word % 2 == 0 {
                (1 << 136) - 1
            } else {
                (1 << 120) - 1
            }
            word += 1
        }
    }
    bytes_from_words(words)
}

fn selector<E: ErrorVariant<Sol>>() -> u32 {
    E::SELECTOR
}

// What the reference verifier returned is what the Fe errors of the same name encode.
#[test]
fn test_reference_selectors_are_the_fe_error_selectors() {
    assert!(
        PROOF_LENGTH_WRONG_WITH_LOG_N == selector<ProofLengthWrongWithLogN>(),
    )
    assert!(VALUE_GE_LIMB_MAX == selector<ValueGeLimbMax>())
    assert!(VALUE_GE_GROUP_ORDER == selector<ValueGeGroupOrder>())
    assert!(VALUE_GE_FIELD_ORDER == selector<ValueGeFieldOrder>())
    assert!(
        PUBLIC_INPUTS_LENGTH_WRONG == selector<PublicInputsLengthWrong>(),
    )
    assert!(SUMCHECK_FAILED == selector<SumcheckFailed>())
    assert!(
        CONSISTENCY_CHECK_FAILED == selector<ConsistencyCheckFailed>(),
    )
    assert!(SHPLEMINI_FAILED == selector<ShpleminiFailed>())
}

#[test]
fn test_cases_address_words_inside_the_proof() {
    let words = PROOF_LENGTH / 32
    for flip in BIT_FLIPS {
        assert!(flip.word < words)
    }
    for overwrite in OVERWRITES {
        assert!(overwrite.word < words)
    }
    assert!(BIT_FLIP_WITHOUT_REVERT_DATA < words)
    for word in SUMCHECK_RETURNS_FALSE {
        assert!(word < words)
    }
    for word in SUMCHECK_RETURNS_TRUE {
        assert!(word < words)
    }
    assert!(Q_OVERWRITE_RUNS[5].end == words)
    for change in PUBLIC_INPUT_CHANGES {
        assert!(change.index < 2)
    }
}
