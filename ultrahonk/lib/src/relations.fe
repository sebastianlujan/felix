#[test]
fn test_poseidon2_external_relation_matches_reference() {
    var synth: [u256; 31] = [0; 31]
    poseidon2_external(p: SYNTH_EVALS, pow: SYNTH_POW, evals: mut synth)
    assert!(synth_only(synth, first: 23, end: 27))

