// The ten relations together: every slot, the batched value, and a tampered evaluation.

#[test]
fn test_subrelations_match_reference() {
    assert!(
        subrelations(p: SYNTH_EVALS, rp: synth_params(), pow: SYNTH_POW) == SYNTH_SUBRELATIONS,
    )
    assert!(
        subrelations(p: PROOF_EVALS, rp: proof_params(), pow: PROOF_POW) == PROOF_SUBRELATIONS,
    )
}

#[test]
fn test_batch_matches_reference() {
    assert!(
        batch(evals: SYNTH_SUBRELATIONS, alpha: SYNTH_ALPHA) == SYNTH_BATCHED,
    )
    assert!(
        batch(evals: PROOF_SUBRELATIONS, alpha: PROOF_ALPHA) == PROOF_BATCHED,
    )
}

#[test]
fn test_accumulate_matches_reference() {
    assert!(
        accumulate(
                evaluations: SYNTH_EVALS,
                params: synth_params(),
                alpha: SYNTH_ALPHA,
                pow: SYNTH_POW,
            )
            == SYNTH_BATCHED,
    )
    assert!(
        accumulate(
                evaluations: PROOF_EVALS,
                params: proof_params(),
                alpha: PROOF_ALPHA,
                pow: PROOF_POW,
            )
            == PROOF_BATCHED,
    )
}

// Adding one to a single evaluation gives the value the reference gives for the same
// change, which is not the value of the untouched inputs.
#[test]
fn test_accumulate_follows_a_changed_evaluation() {
    var synth = SYNTH_EVALS
    synth[TAMPERED_ENTITY] = add(synth[TAMPERED_ENTITY], 1)
    let synth_result = accumulate(
        evaluations: synth,
        params: synth_params(),
        alpha: SYNTH_ALPHA,
        pow: SYNTH_POW,
    )
    assert!(synth_result == SYNTH_BATCHED_TAMPERED)
    assert!(synth_result != SYNTH_BATCHED)

    var proof = PROOF_EVALS
    proof[TAMPERED_ENTITY] = add(proof[TAMPERED_ENTITY], 1)
    let proof_result = accumulate(
        evaluations: proof,
        params: proof_params(),
        alpha: PROOF_ALPHA,
        pow: PROOF_POW,
    )
    assert!(proof_result == PROOF_BATCHED_TAMPERED)
    assert!(proof_result != PROOF_BATCHED)
}
