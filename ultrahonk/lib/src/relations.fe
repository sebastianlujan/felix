// The UltraHonk relations, evaluated at the sumcheck point.
//
// Port of `RelationsLib` in the Solidity verifier that Barretenberg 6.0.0 generates
// with `-t evm`. Each relation reads the 41 entity evaluations and writes its
// subrelations into fixed slots of a shared array of 31; the slots are not in call
// order. `accumulate` runs all ten and batches the 31 values with powers of alpha.
//
// Every input must be reduced (< P): `fr::sub` panics on a larger subtrahend where
// the reference wraps. Outputs are reduced, so they equal the reference's bit for bit.
//
// Where the reference repeats a product or writes `x * MINUS_ONE + ONE`, this port
// computes it once or writes `1 - x`; the values are the same field elements.
use super::fr::{add, mul, sub}
use super::relations_vectors::*
use super::wire::*

pub const NUMBER_OF_SUBRELATIONS: usize = 31

/// Challenges and derived values shared by the relations.
pub struct RelationParameters {
    pub eta: u256,
    /// Additive offset of the ROM log-derivative argument.
    pub rom_logup_gamma: u256,
    pub beta: u256,
    pub gamma: u256,
    pub public_inputs_delta: u256,
}

/// `-1/2` in the scalar field: `NEG_HALF_MODULO_P` of the reference.
const NEG_HALF_MODULO_P: u256 = 0x183227397098d014dc2822db40c0ac2e9419f4243cdcb848a1f0fac9f8000000

/// Arithmetic relation: slots 6 and 7.
pub fn arithmetic(p: [u256; 41], pow: u256, evals: mut [u256; NUMBER_OF_SUBRELATIONS]) {
    let q_arith = p[Q_ARITH]
    let q_arith_by_scaling = mul(q_arith, pow)

    // (q_arith - 3) * q_m * w_r * w_l * (-1/2) + q_l w_l + q_r w_r + q_o w_o + q_4 w_4 + q_c
    //     + (q_arith - 1) * w_4_shift
    var accum = mul(
        mul(sub(q_arith, 3), mul(mul(p[Q_M], p[W_R]), p[W_L])),
        NEG_HALF_MODULO_P,
    )
    accum = add(accum, mul(p[Q_L], p[W_L]))
    accum = add(accum, mul(p[Q_R], p[W_R]))
    accum = add(accum, mul(p[Q_O], p[W_O]))
    accum = add(accum, mul(p[Q_4], p[W_4]))
    accum = add(accum, p[Q_C])
    accum = add(accum, mul(sub(q_arith, 1), p[W_4_SHIFT]))
    evals[6] = mul(accum, q_arith_by_scaling)

    // (w_l + w_4 - w_l_shift + q_m) * (q_arith - 2) * (q_arith - 1)
    var accum_two = add(sub(add(p[W_L], p[W_4]), p[W_L_SHIFT]), p[Q_M])
    accum_two = mul(accum_two, sub(q_arith, 2))
    accum_two = mul(accum_two, sub(q_arith, 1))
    evals[7] = mul(accum_two, q_arith_by_scaling)
}

/// (w_1 + s_1 beta + gamma) ... (w_4 + s_4 beta + gamma), where `s_1..s_4` are the four
/// consecutive entities starting at `first`: the identity or the sigma polynomials.
fn grand_product(p: [u256; 41], first: usize, rp: RelationParameters) -> u256 {
    var product: u256 = 1
    var i: usize = 0
    while i < 4 {
        product = mul(
            product,
            add(add(p[W_L + i], mul(p[first + i], rp.beta)), rp.gamma),
        )
        i += 1
    }
    product
}

/// Permutation relation: slots 0 to 2.
pub fn permutation(
    p: [u256; 41],
    rp: RelationParameters,
    pow: u256,
    evals: mut [u256; NUMBER_OF_SUBRELATIONS],
) {
    let grand_product_numerator = grand_product(p, first: ID_1, rp)
    let grand_product_denominator = grand_product(p, first: SIGMA_1, rp)

    let acc = sub(
        mul(
            add(p[Z_PERM], p[LAGRANGE_FIRST]),
            grand_product_numerator,
        ),
        mul(
            add(
                p[Z_PERM_SHIFT],
                mul(p[LAGRANGE_LAST], rp.public_inputs_delta),
            ),
            grand_product_denominator,
        ),
    )
    evals[0] = mul(acc, pow)
    evals[1] = mul(mul(p[LAGRANGE_LAST], p[Z_PERM_SHIFT]), pow)
    // z_perm initialization check: lagrange_first * z_perm = 0
    evals[2] = mul(mul(p[LAGRANGE_FIRST], p[Z_PERM]), pow)
}

/// Log-derivative lookup relation: slots 3 to 5.
pub fn lookup(
    p: [u256; 41],
    rp: RelationParameters,
    pow: u256,
    evals: mut [u256; NUMBER_OF_SUBRELATIONS],
) {
    let beta = rp.beta
    let beta_sqr = mul(beta, beta)
    let beta_cube = mul(beta_sqr, beta)

    // Write term: table_1 + gamma + table_2 * beta + table_3 * beta^2 + table_4 * beta^3
    var table_term = add(p[TABLE_1], rp.gamma)
    table_term = add(table_term, mul(p[TABLE_2], beta))
    table_term = add(table_term, mul(p[TABLE_3], beta_sqr))
    table_term = add(table_term, mul(p[TABLE_4], beta_cube))

    // Read term: entry_1 + gamma + entry_2 * beta + entry_3 * beta^2 + q_o * beta^3
    let derived_entry_1 = add(add(p[W_L], rp.gamma), mul(p[Q_R], p[W_L_SHIFT]))
    let derived_entry_2 = add(p[W_R], mul(p[Q_M], p[W_R_SHIFT]))
    let derived_entry_3 = add(p[W_O], mul(p[Q_C], p[W_O_SHIFT]))
    var lookup_term = add(derived_entry_1, mul(derived_entry_2, beta))
    lookup_term = add(lookup_term, mul(derived_entry_3, beta_sqr))
    lookup_term = add(lookup_term, mul(p[Q_O], beta_cube))

    let inverses = p[LOOKUP_INVERSES]
    let lookup_inverse = mul(inverses, table_term)
    let table_inverse = mul(inverses, lookup_term)

    let read_tag = p[LOOKUP_READ_TAGS]
    let q_lookup = p[Q_LOOKUP]
    let inverse_exists_xor = sub(add(read_tag, q_lookup), mul(read_tag, q_lookup))

    // The inverse is correct wherever it is needed.
    evals[3] = mul(
        sub(
            mul(mul(lookup_term, table_term), inverses),
            inverse_exists_xor,
        ),
        pow,
    )
    // The log-derivative sum. It holds over the whole trace, not row by row, so the
    // reference does not scale it by the domain separator.
    evals[4] = sub(
        mul(q_lookup, lookup_inverse),
        mul(p[LOOKUP_READ_COUNTS], table_inverse),
    )
    // The read tag is boolean.
    evals[5] = mul(sub(mul(read_tag, read_tag), read_tag), pow)
}

/// delta * (delta - 1) * (delta - 2) * (delta - 3): zero when `delta` is 0, 1, 2 or 3.
fn range_product(_ delta: u256) -> u256 {
    var acc = mul(delta, sub(delta, 1))
    acc = mul(acc, sub(delta, 2))
    mul(acc, sub(delta, 3))
}

/// Delta range relation: slots 8 to 11.
pub fn delta_range(p: [u256; 41], pow: u256, evals: mut [u256; NUMBER_OF_SUBRELATIONS]) {
    let q_range_by_scaling = mul(p[Q_RANGE], pow)
    evals[8] = mul(range_product(sub(p[W_R], p[W_L])), q_range_by_scaling)
    evals[9] = mul(range_product(sub(p[W_O], p[W_R])), q_range_by_scaling)
    evals[10] = mul(range_product(sub(p[W_4], p[W_O])), q_range_by_scaling)
    evals[11] = mul(
        range_product(sub(p[W_L_SHIFT], p[W_4])),
        q_range_by_scaling,
    )
}

/// RAM/ROM memory relation: slots 14 to 19.
///
/// Gate layout: `w1` index, `w2` timestamp (RAM) or second value (ROM), `w3` value,
/// `w4` record, `q_c` access type (RAM only).
pub fn memory(
    p: [u256; 41],
    rp: RelationParameters,
    pow: u256,
    evals: mut [u256; NUMBER_OF_SUBRELATIONS],
) {
    let eta = rp.eta
    let eta_two = mul(eta, eta)
    let eta_three = mul(eta_two, eta)
    let q_memory_by_scaling = mul(p[Q_MEMORY], pow)

    // Record check: q_c + w1 * eta + w2 * eta^2 + w3 * eta^3 - w4 = 0.
    var memory_record_check = mul(p[W_O], eta_three)
    memory_record_check = add(memory_record_check, mul(p[W_R], eta_two))
    memory_record_check = add(memory_record_check, mul(p[W_L], eta))
    memory_record_check = add(memory_record_check, p[Q_C])
    let partial_record_check = memory_record_check
    memory_record_check = sub(memory_record_check, p[W_4])

    // ROM consistency: in the sorted records, indices increase by 0 or 1, and
    // records with the same index are equal.
    let index_delta = sub(p[W_L_SHIFT], p[W_L])
    let record_delta = sub(p[W_4_SHIFT], p[W_4])
    let index_is_monotonically_increasing = mul(index_delta, sub(index_delta, 1))
    let indices_match = sub(1, index_delta)
    let adjacent_values_match_if_adjacent_indices_match = mul(indices_match, record_delta)

    let q_l_by_q_r = mul(p[Q_L], p[Q_R])
    evals[15] = mul(
        mul(
            adjacent_values_match_if_adjacent_indices_match,
            q_l_by_q_r,
        ),
        q_memory_by_scaling,
    )
    evals[16] = mul(
        mul(index_is_monotonically_increasing, q_l_by_q_r),
        q_memory_by_scaling,
    )
    let rom_consistency_check_identity = mul(memory_record_check, q_l_by_q_r)

    // RAM consistency: the access type `w4 - partial_record_check` is boolean, and two
    // adjacent records with the same index hold the same value when the next one is a read.
    let access_type = sub(p[W_4], partial_record_check)
    let access_check = mul(access_type, sub(access_type, 1))

    var next_gate_access_type = mul(p[W_O_SHIFT], eta_three)
    next_gate_access_type = add(next_gate_access_type, mul(p[W_R_SHIFT], eta_two))
    next_gate_access_type = add(next_gate_access_type, mul(p[W_L_SHIFT], eta))
    next_gate_access_type = sub(p[W_4_SHIFT], next_gate_access_type)

    let value_delta = sub(p[W_O_SHIFT], p[W_O])
    let adjacent_values_match_if_adjacent_indices_match_and_next_access_is_a_read_operation = mul(
        mul(indices_match, value_delta),
        sub(1, next_gate_access_type),
    )
    // The last sorted record has no successor to run the check above against, so the
    // next gate's access type is constrained to be boolean as well.
    let next_gate_access_type_is_boolean = sub(
        mul(next_gate_access_type, next_gate_access_type),
        next_gate_access_type,
    )

    let q_o_by_scaling = mul(p[Q_O], q_memory_by_scaling)
    evals[17] = mul(
        adjacent_values_match_if_adjacent_indices_match_and_next_access_is_a_read_operation,
        q_o_by_scaling,
    )
    evals[18] = mul(index_is_monotonically_increasing, q_o_by_scaling)
    evals[19] = mul(next_gate_access_type_is_boolean, q_o_by_scaling)
    let ram_consistency_check_identity = mul(access_check, p[Q_O])

    // RAM timestamp check: (1 - index_delta) * timestamp_delta - w3 = 0.
    let timestamp_delta = sub(p[W_R_SHIFT], p[W_R])
    let ram_timestamp_check_identity = sub(mul(indices_match, timestamp_delta), p[W_O])

    var memory_identity = rom_consistency_check_identity
    memory_identity = add(
        memory_identity,
        mul(ram_timestamp_check_identity, mul(p[Q_4], p[Q_L])),
    )
    memory_identity = add(
        memory_identity,
        mul(memory_record_check, mul(p[Q_M], p[Q_L])),
    )
    memory_identity = add(memory_identity, ram_consistency_check_identity)
    evals[14] = mul(memory_identity, q_memory_by_scaling)
}

fn proof_params() -> RelationParameters {
    RelationParameters {
        eta: PROOF_ETA,
        rom_logup_gamma: PROOF_ROM_LOGUP_GAMMA,
        beta: PROOF_BETA,
        gamma: PROOF_GAMMA,
        public_inputs_delta: PROOF_PUBLIC_INPUTS_DELTA,
    }
}

fn synth_params() -> RelationParameters {
    RelationParameters {
        eta: SYNTH_ETA,
        rom_logup_gamma: SYNTH_ROM_LOGUP_GAMMA,
        beta: SYNTH_BETA,
        gamma: SYNTH_GAMMA,
        public_inputs_delta: SYNTH_PUBLIC_INPUTS_DELTA,
    }
}

/// True if `evals` holds `expected` in slots `first..end` and zero in every other slot:
/// what a relation run alone on a zeroed array must leave.
fn only_slots(_ evals: [u256; 31], expected: [u256; 31], first: usize, end: usize) -> bool {
    var i: usize = 0
    while i < NUMBER_OF_SUBRELATIONS {
        let want = if i >= first && i < end {
            expected[i]
        } else {
            0
        }
        if evals[i] != want {
            return false
        }
        i += 1
    }
    true
}

fn proof_only(_ evals: [u256; 31], first: usize, end: usize) -> bool {
    only_slots(evals, expected: PROOF_SUBRELATIONS, first, end)
}

fn synth_only(_ evals: [u256; 31], first: usize, end: usize) -> bool {
    only_slots(evals, expected: SYNTH_SUBRELATIONS, first, end)
}

// One test per relation: run alone on a zeroed array, it leaves the reference's values
// in its own slots and nothing elsewhere, for the synthetic inputs (every slot non-zero)
// and for the pinned proof (slots 8 to 30 are zero).

#[test]
fn test_arithmetic_relation_matches_reference() {
    var synth: [u256; 31] = [0; 31]
    arithmetic(p: SYNTH_EVALS, pow: SYNTH_POW, evals: mut synth)
    assert!(synth_only(synth, first: 6, end: 8))

    var proof: [u256; 31] = [0; 31]
    arithmetic(p: PROOF_EVALS, pow: PROOF_POW, evals: mut proof)
    assert!(proof_only(proof, first: 6, end: 8))
}

#[test]
fn test_permutation_relation_matches_reference() {
    var synth: [u256; 31] = [0; 31]
    permutation(
        p: SYNTH_EVALS,
        rp: synth_params(),
        pow: SYNTH_POW,
        evals: mut synth,
    )
    assert!(synth_only(synth, first: 0, end: 3))

    var proof: [u256; 31] = [0; 31]
    permutation(
        p: PROOF_EVALS,
        rp: proof_params(),
        pow: PROOF_POW,
        evals: mut proof,
    )
    assert!(proof_only(proof, first: 0, end: 3))
}

#[test]
fn test_lookup_relation_matches_reference() {
    var synth: [u256; 31] = [0; 31]
    lookup(
        p: SYNTH_EVALS,
        rp: synth_params(),
        pow: SYNTH_POW,
        evals: mut synth,
    )
    assert!(synth_only(synth, first: 3, end: 6))

    var proof: [u256; 31] = [0; 31]
    lookup(
        p: PROOF_EVALS,
        rp: proof_params(),
        pow: PROOF_POW,
        evals: mut proof,
    )
    assert!(proof_only(proof, first: 3, end: 6))
}

#[test]
fn test_delta_range_relation_matches_reference() {
    var synth: [u256; 31] = [0; 31]
    delta_range(p: SYNTH_EVALS, pow: SYNTH_POW, evals: mut synth)
    assert!(synth_only(synth, first: 8, end: 12))

    var proof: [u256; 31] = [0; 31]
    delta_range(p: PROOF_EVALS, pow: PROOF_POW, evals: mut proof)
    assert!(proof_only(proof, first: 8, end: 12))
}

#[test]
fn test_memory_relation_matches_reference() {
    var synth: [u256; 31] = [0; 31]
    memory(
        p: SYNTH_EVALS,
        rp: synth_params(),
        pow: SYNTH_POW,
        evals: mut synth,
    )
    assert!(synth_only(synth, first: 14, end: 20))

    var proof: [u256; 31] = [0; 31]
    memory(
        p: PROOF_EVALS,
        rp: proof_params(),
        pow: PROOF_POW,
        evals: mut proof,
    )
    assert!(proof_only(proof, first: 14, end: 20))
}
