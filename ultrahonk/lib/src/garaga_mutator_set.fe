use std::abi::{Bytes32, bytes_from_words, dyn_array_from}
use super::garaga_mutator_set_proof::{PROOF, PUBLIC_INPUTS}
use super::types::VerificationKey

pub const VK: VerificationKey = VerificationKey {
    log_n: LOG_N,
    num_public_inputs: NUM_PUBLIC_INPUTS,
    vk_hash: VK_HASH,
    points: VK_POINTS,
}

fn proof() -> Bytes {
    bytes_from_words(PROOF)
}

/// The three public inputs, with the one at `index` replaced by `value`.
fn public_inputs_with(index: usize, value: u256) -> Vec<Bytes32> {
    var inputs = PUBLIC_INPUTS
    inputs[index] = value
    dyn_array_from(
        [Bytes32 { val: inputs[0] }, Bytes32 { val: inputs[1] }, Bytes32 { val: inputs[2] }],
    )
}

fn public_inputs() -> Vec<Bytes32> {
    public_inputs_with(index: 0, value: PUBLIC_INPUTS[0])
}

// Tests: every step of the verifier (`verifier::verify`), at `LOG_N = 17` and with three
// public inputs. Garaga pins no challenges for this proof.
use std::evm::Evm
use super::verifier::{accepted_bit_flips, accepts, deploy_keyed_verifier, verify}

#[test]
fn test_garaga_mutator_set_is_accepted() {
    assert!(verify(vk: VK, proof(), public_inputs()))
}

// The low bit of each of the 286 proof words, one word at a time.
#[test]
fn test_garaga_mutator_set_with_one_bit_changed_is_never_accepted()
uses (evm: mut Evm)
{
    assert!(PROOF.len() == 286)
    assert!(
        accepted_bit_flips(vk: VK, words: PROOF, public_inputs: public_inputs()) == 0,
    )
}

// Each of the three public inputs in turn, one more than the proof was made for.
#[test]
fn test_garaga_mutator_set_with_a_changed_public_input_is_not_accepted()
uses (evm: mut Evm)
{
    let verifier = deploy_keyed_verifier()
    assert!(
        accepts(
            verifier,
            vk: VK,
            proof: proof(),
            public_inputs: public_inputs(),
        ),
    )
    for index in 0 .. PUBLIC_INPUTS.len() {
        let changed = public_inputs_with(index, value: PUBLIC_INPUTS[index] + 1)
        assert!(
            !accepts(verifier, vk: VK, proof: proof(), public_inputs: changed),
        )
    }
}
