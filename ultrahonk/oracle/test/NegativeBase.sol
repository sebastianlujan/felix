pragma solidity ^0.8.27;

import {Test} from "forge-std/Test.sol";
import {Errors, IVerifier, LOG_N} from "../src/HonkVerifier.sol";

/// @notice Expectations shared by every `IVerifier` implementation for the vault circuit.
/// @dev A concrete suite only chooses the verifier to deploy, so the Solidity verifier
///      generated by bb and the Fe port are held to the same cases, down to the revert data.
///      Cases move here from `NegativeSol` as the Fe port implements the matching check.
abstract contract NegativeBase is Test {
    uint256 internal constant WORD = 32;
    uint256 internal constant PROOF_LENGTH = (67 + 11 * LOG_N) * WORD;

    IVerifier internal verifier;
    bytes internal proof;
    bytes32[] internal publicInputs;

    function _createVerifier() internal virtual returns (IVerifier);

    function setUp() public {
        verifier = _createVerifier();
        proof = vm.readFileBinary("../vectors/proof");

        bytes memory raw = vm.readFileBinary("../vectors/public_inputs");
        require(raw.length % WORD == 0, "public_inputs is not a whole number of words");
        // The file is the bare words; prefixing offset and length makes it an ABI-encoded bytes32[].
        publicInputs = abi.decode(abi.encodePacked(WORD, raw.length / WORD, raw), (bytes32[]));
    }

    function test_RevertWhen_ProofIsOneWordShort() public {
        _expectProofLengthRevert(PROOF_LENGTH - WORD);
    }

    function test_RevertWhen_ProofIsOneWordLong() public {
        _expectProofLengthRevert(PROOF_LENGTH + WORD);
    }

    function testFuzz_RevertWhen_ProofLengthIsWrong(uint256 length) public {
        length = bound(length, 0, 2 * PROOF_LENGTH);
        vm.assume(length != PROOF_LENGTH);
        _expectProofLengthRevert(length);
    }

    function _expectProofLengthRevert(uint256 length) internal {
        bytes memory resized = _resized(proof, length);
        vm.expectRevert(abi.encodeWithSelector(Errors.ProofLengthWrongWithLogN.selector, LOG_N, length, PROOF_LENGTH));
        verifier.verify(resized, publicInputs);
    }

    /// @dev `data` truncated or zero-padded to `length` bytes.
    function _resized(bytes memory data, uint256 length) internal pure returns (bytes memory out) {
        out = new bytes(length);
        uint256 kept = length < data.length ? length : data.length;
        for (uint256 i = 0; i < kept; i++) {
            out[i] = data[i];
        }
    }

    /// @dev The valid proof with the lowest bit of word `wordIndex` flipped.
    function _proofWithFlippedBit(uint256 wordIndex) internal view returns (bytes memory tampered) {
        tampered = proof;
        uint256 lastByte = wordIndex * WORD + WORD - 1;
        tampered[lastByte] = tampered[lastByte] ^ 0x01;
    }
}
