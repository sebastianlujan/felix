// UltraHonk verifier contract for the vault circuit (ZK flavor).
//
// Not a verifier yet. It has the ABI of the Solidity `HonkVerifier` and runs its checks,
// in its order and with its errors, up to the sumcheck rounds. What follows them (the
// relations, Shplemini, the pairing) does not exist, so a call that passes every
// implemented check reverts with `VerificationNotImplemented`. It never accepts a proof.
use std::abi::Bytes32
use ultrahonk::abi::VerifierMsg
use ultrahonk::errors::PublicInputsLengthWrong
use ultrahonk::proof::validate
use ultrahonk::sumcheck::{public_input_delta, rounds}
use ultrahonk::transcript::generate
use ultrahonk::types::PAIRING_POINTS_SIZE
use ultrahonk::vectors::VK

/// Raised once every implemented check has passed: nothing after them exists yet.
#[error]
pub struct VerificationNotImplemented {}

fn verify(_ proof: Bytes, _ public_inputs: Vec<Bytes32>) -> bool {
    validate(proof, log_n: VK.log_n)
    if public_inputs.len() != VK.num_public_inputs - PAIRING_POINTS_SIZE {
        revert_error(PublicInputsLengthWrong {})
    }
    let t = generate(vk: VK, proof, public_inputs)
    // Computed where the reference computes it; the relations will read it.
    let _delta = public_input_delta(proof, public_inputs, beta: t.beta, gamma: t.gamma)
    let _reduced = rounds(proof, t, log_n: VK.log_n)
    revert_error(VerificationNotImplemented {})
}

pub contract HonkVerifier {
    recv VerifierMsg {
        Verify { proof, public_inputs } -> bool {
            verify(proof, public_inputs)
        }
    }
}

// Tests. Each deploys the contract and compares the revert data of one or more calls with
// what the reference verifier returned for the same call, as recorded in
// `ultrahonk::expected`. The exceptions say so: the calls that pass every implemented check
// (the reference accepted the valid proof; nothing here does) and the all-zero proof.
use core::error::ErrorVariant
use std::abi::{Sol, bytes_from_words, dyn_array_from}
use std::evm::{Evm, revert_selector}
use ultrahonk::expected
use ultrahonk::fr::{P, Q}
use ultrahonk::proof::evaluations
use ultrahonk::vectors::{LOG_N, PROOF, PUBLIC_INPUTS, proof, proof_with, public_inputs}

// The reference verifier was called with this much gas when the reverts were recorded.
const GAS: u256 = 20000000

fn not_implemented() -> u32 {
    <VerificationNotImplemented as ErrorVariant<Sol>>::SELECTOR
}

fn deploy() -> Address uses (evm: mut Evm) {
    evm.create2<HonkVerifier>(value: Wei::zero(), args: (), salt: 0)
}

/// Calls `verify` and returns the selector it reverted with. The call must revert, with
/// revert data that is the selector alone (true of every error but the proof-length one).
fn revert_of(verifier: Address, proof: own Bytes, public_inputs: own Vec<Bytes32>) -> u32
uses (evm: mut Evm)
{
    let outcome = evm
        .try_call(
            addr: verifier,
            gas: GAS,
            value: Wei::zero(),
            message: VerifierMsg::Verify { proof, public_inputs },
        )
    assert!(!outcome.success())
    assert!(outcome.returndata_len() == 4)
    revert_selector(outcome.returndata()).unwrap()
}

fn one_input(_ value: u256) -> Vec<Bytes32> {
    dyn_array_from([Bytes32 { val: value }])
}

fn two_inputs(_ first: u256, _ second: u256) -> Vec<Bytes32> {
    dyn_array_from([Bytes32 { val: first }, Bytes32 { val: second }])
}

// selector of ProofLengthWrongWithLogN(uint256,uint256,uint256)
#[test(should_revert, selector = 0x59895a53)]
fn test_wrong_proof_length_reverts() uses (evm: mut Evm) {
    let verifier = deploy()
    let _: bool = evm
        .call(
            addr: verifier,
            gas: GAS,
            value: Wei::zero(),
            message: VerifierMsg::Verify {
                proof: bytes_from_words([1, 2, 3]),
                public_inputs: public_inputs(),
            },
        )
}

// Not a recorded case. A proof of the right length made of zeros passes every implemented
// check: the round checks alone do not bind a proof to the circuit.
// selector of VerificationNotImplemented()
#[test(should_revert, selector = 0x342c2ccd)]
fn test_right_proof_length_is_not_accepted() uses (evm: mut Evm) {
    let verifier = deploy()
    let _: bool = evm
        .call(
            addr: verifier,
            gas: GAS,
            value: Wei::zero(),
            message: VerifierMsg::Verify {
                proof: Bytes::zeroed(expected::PROOF_LENGTH),
                public_inputs: public_inputs(),
            },
        )
}

// The reference verifier returned true for this call. This contract must not, at this stage.
#[test]
fn test_the_valid_proof_is_not_accepted_yet() uses (evm: mut Evm) {
    let verifier = deploy()
    assert!(
        revert_of(verifier, proof: proof(), public_inputs: public_inputs()) == not_implemented(),
    )
}

// The whole revert data, not only its selector, equals what the reference verifier
// returned for a proof of the same length.
#[test]
fn test_wrong_proof_length_revert_data_matches_reference() uses (evm: mut Evm) {
    let verifier = deploy()
    for length in expected::WRONG_LENGTHS {
        let outcome = evm
            .try_call(
                addr: verifier,
                gas: GAS,
                value: Wei::zero(),
                message: VerifierMsg::Verify {
                    proof: Bytes::zeroed(length),
                    public_inputs: public_inputs(),
                },
            )
        assert!(!outcome.success())
        assert!(outcome.returndata_len() == 100)
        assert!(
            revert_selector(outcome.returndata()).unwrap()
                == expected::PROOF_LENGTH_WRONG_WITH_LOG_N,
        )
        let data = Bytes::from_payload(source: outcome.returndata())
        assert!(data.word_at(4) == expected::WRONG_LENGTH_LOG_N)
        assert!(data.word_at(36) == length as u256)
        assert!(data.word_at(68) == expected::PROOF_LENGTH as u256)
    }
}

#[test]
fn test_overwritten_proof_words_revert_as_the_reference() uses (evm: mut Evm) {
    let verifier = deploy()
    for overwrite in expected::OVERWRITES {
        let tampered = proof_with(word: overwrite.word, value: overwrite.value)
        assert!(
            revert_of(verifier, proof: tampered, public_inputs: public_inputs())
                == overwrite.selector,
        )
    }
}

// Every proof word set to Q, one at a time: the selector tells whether the contract reads
// the word as a limb, a point coordinate or a scalar, for all 142 words.
#[test]
fn test_every_proof_word_is_range_checked_as_in_the_reference()
uses (evm: mut Evm)
{
    let verifier = deploy()
    var word: usize = 0
    for run in expected::Q_OVERWRITE_RUNS {
        while word < run.end {
            let tampered = proof_with(word, value: Q)
            assert!(
                revert_of(verifier, proof: tampered, public_inputs: public_inputs())
                    == run.selector,
            )
            word += 1
        }
    }
    assert!(word == PROOF.len())
}

#[test]
fn test_changed_public_inputs_revert_as_the_reference() uses (evm: mut Evm) {
    let verifier = deploy()
    for change in expected::PUBLIC_INPUT_CHANGES {
        var inputs = PUBLIC_INPUTS
        inputs[change.index] = change.value
        assert!(
            revert_of(
                    verifier,
                    proof: proof(),
                    public_inputs: two_inputs(inputs[0], inputs[1]),
                )
                == change.selector,
        )
    }
}

#[test]
fn test_wrong_public_input_counts_revert_as_the_reference()
uses (evm: mut Evm)
{
    let verifier = deploy()
    assert!(expected::WRONG_PUBLIC_INPUT_COUNTS == [1, 3])
    let one = one_input(PUBLIC_INPUTS[0])
    let three = dyn_array_from(
        [Bytes32 { val: PUBLIC_INPUTS[0] }, Bytes32 { val: PUBLIC_INPUTS[1] }, Bytes32 { val: 0 }],
    )
    assert!(
        revert_of(verifier, proof: proof(), public_inputs: one)
            == expected::PUBLIC_INPUTS_LENGTH_WRONG,
    )
    assert!(
        revert_of(verifier, proof: proof(), public_inputs: three)
            == expected::PUBLIC_INPUTS_LENGTH_WRONG,
    )
}

// The four calls that break two rules at once (end of `expected.fe`): the reference
// checks the proof words in order, then the number of public inputs, then their range.
#[test]
fn test_checks_run_in_the_order_of_the_reference() uses (evm: mut Evm) {
    let verifier = deploy()

    var words = PROOF
    words[0] = 1 << 136
    words[141] = Q
    assert!(
        revert_of(
                verifier,
                proof: bytes_from_words(words),
                public_inputs: public_inputs(),
            )
            == expected::VALUE_GE_LIMB_MAX,
    )

    words = PROOF
    words[8] = Q
    words[28] = P
    assert!(
        revert_of(
                verifier,
                proof: bytes_from_words(words),
                public_inputs: public_inputs(),
            )
            == expected::VALUE_GE_GROUP_ORDER,
    )

    assert!(
        revert_of(
                verifier,
                proof: proof_with(word: 28, value: P),
                public_inputs: one_input(PUBLIC_INPUTS[0]),
            )
            == expected::VALUE_GE_FIELD_ORDER,
    )

    assert!(
        revert_of(verifier, proof: proof(), public_inputs: one_input(P))
            == expected::PUBLIC_INPUTS_LENGTH_WRONG,
    )
}

// A flipped bit in a word before the evaluations changes a challenge or a round value,
// so the round checks decide it, as `SumcheckFailed` in the reference too. From the
// evaluations on, the reference rejects in steps this contract does not have: those
// proofs pass every implemented check and stop at `VerificationNotImplemented`.
#[test]
fn test_bit_flips_decided_by_the_round_checks_revert_as_the_reference()
uses (evm: mut Evm)
{
    let verifier = deploy()
    for flip in expected::BIT_FLIPS {
        let tampered = proof_with(word: flip.word, value: PROOF[flip.word] ^ 1)
        let selector = revert_of(verifier, proof: tampered, public_inputs: public_inputs())
        if flip.word < evaluations(LOG_N) {
            assert!(selector == flip.selector)
        } else {
            assert!(selector == not_implemented())
        }
    }
}
